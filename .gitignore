# Build output
*.o
# The precompiled vendor core object is REQUIRED to link the mtgpu module
# (the rest of the driver is built from source). Track it explicitly.
*.o_binary
!driver-s30-3.1.0/objs/**/mtgpu_core.o_binary
*.ko
*.ko.xz
*.mod
*.mod.c
.*.cmd
modules.order
Module.symvers
conftest.h
.tmp/
build/

# Kernel / DKMS scratch
dkms-*/
*.deb
*.rpm
*.tar.gz

# Logs and runtime state
*.log
.logs/
logs/

# Editor / tool state
.vscode/
.idea/
.cache/
vtcode.toml
.autohand/
.dirac/
.harn/
.qoder/
.vtcode/
.opencode/

# RPM packaging build artifacts
packaging/rpm/BUILD/
packaging/rpm/BUILDROOT/
packaging/rpm/RPMS/
packaging/rpm/SRPMS/
packaging/rpm/local-build/
packaging/rpm/local-build-dkms/
packaging/rpm/local-build-va/
packaging/rpm/work/

# The generated source tarballs are rebuilt from the vendor debs by
# create-sources.sh / create-sdk-sources.sh; do not commit 100-240 MB blobs.
packaging/rpm/SOURCES/*.tar.gz

# Vendor SDK and compiler artifacts
tools/
usr/local/musa-5.2/
usr/local/musa-5.2.0/
/usr/local/musa-5.2/lib/

# Extracted vendor userspace runtime (regenerable from the vendor deb by
# create-sources.sh). Contains multi-hundred-MB .so blobs that exceed the
# GitHub 100 MB/file limit; never commit it.
userspace/

# Rollback backups
.rollback/

# Temporary and generated
*.orig
*~

# Local credentials and secrets
.copr
.coprconfig
.netrc
.authinfo
.env
.env.*
!.env.example
!.env.*.example
id_rsa
id_ed25519
*.p12
*.pfx
*.pem

# Additional build caches
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
cmake-build-*/
*.cache

# Generated GPU/API smoke-test binaries
/tests/musa-vector-add
/tests/musart-smoke
/tests/musa-compute
/tests/musa-fp64
/tests/vulkan-enumerate
/tests/opencl-platforms
/tests/opencl-s30-smoke

# RPM signing revocation material (keep private)
*.rev
